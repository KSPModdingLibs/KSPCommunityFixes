<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KSPRoot Condition="'$(KSPRoot)' == ''">$(KSPDIR)</KSPRoot>
    <PCFReferencePath Condition="'$(PCFReferencePath)' == ''">$(KSPRoot)/GameData/PatchedConicFixes/Plugins/PatchedConicFixes.dll</PCFReferencePath>
    <KSPCFReferencePath Condition="'$(KSPCFReferencePath)' == ''">$(MSBuildThisFileDirectory)../KSPCommunityFixes/bin/Release/KSPCommunityFixes.dll</KSPCFReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="All" />
    <Reference Include="KSPCommunityFixes"><HintPath>$(KSPCFReferencePath)</HintPath></Reference>
    <Reference Include="PatchedConicFixes"><HintPath>$(PCFReferencePath)</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(KSPRoot)/KSP_x64_Data/Managed/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(KSPRoot)/KSP_x64_Data/Managed/Assembly-CSharp-firstpass.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSPRoot)/KSP_x64_Data/Managed/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSPRoot)/KSP_x64_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(KSPRoot)/KSP_x64_Data/Managed/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(KSPRoot)/GameData/000_Harmony/0Harmony.dll</HintPath></Reference>
    <Reference Include="Unity.Burst"><HintPath>$(KSPRoot)/GameData/000_KSPBurst/Plugins/Unity.Burst.dll</HintPath></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(KSPRoot)/GameData/000_KSPBurst/Plugins/Unity.Mathematics.dll</HintPath></Reference>
  </ItemGroup>
</Project>
